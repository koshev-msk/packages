+static MMModemBand
+fm350gl_band_from_number (FM350GLBandType type,
+                          guint            number)
+{
+    switch (type) {
+    case FM350GL_BAND_TYPE_UTRAN:
+        switch (number) {
+        case 1:  return MM_MODEM_BAND_UTRAN_1;
+        case 2:  return MM_MODEM_BAND_UTRAN_2;
+        case 3:  return MM_MODEM_BAND_UTRAN_3;
