+
+static gboolean
+fm350gl_parse_hex_u32 (const gchar *str, guint32 *value)
+{
+    gchar *end = NULL;
+    guint64 tmp;
+
+    tmp = g_ascii_strtoull (str, &end, 16);
+    if (end == str || *end != '\0' || tmp > G_MAXUINT32)
+        return FALSE;
+
+    *value = (guint32) tmp;
+    return TRUE;
+}
+
+static gchar *
+fm350gl_clean_epbseh_field (const gchar *field)
+{
+    gchar *clean = g_strdup (field);
+    g_strstrip (clean);
+
+    if (clean[0] == '"') {
+        gsize len = strlen (clean);
+        if (len >= 2 && clean[len - 1] == '"') {
+            clean[len - 1] = '\0';
+            memmove (clean, clean + 1, len - 1);
+        }
+    }
+
+    return clean;
+}
+
+static gboolean
+fm350gl_parse_hex_bitmap (const gchar *str,
+                           guint32      value[4])
+{
+    gsize len;
+    gsize offset;
+    guint i;
+
+    memset (value, 0, sizeof (guint32) * 4);
+
+    len = strlen (str);
+    if (len == 0 || len > 32)
+        return FALSE;
+
+    offset = 0;
+    for (i = 0; i < 4 && offset < len; i++) {
+        gchar chunk[9];
+        gsize chunk_len = MIN ((gsize) 8, len - offset);
+        gchar *end = NULL;
+        guint64 tmp;
+
+        memcpy (chunk, str + offset, chunk_len);
+        chunk[chunk_len] = '\0';
+
+        tmp = g_ascii_strtoull (chunk, &end, 16);
+        if (end == chunk || *end != '\0' || tmp > G_MAXUINT32)
+            return FALSE;
+
+        value[i] = (guint32) tmp;
+        offset += chunk_len;
+    }
+
+    return TRUE;
+}
+
+static gboolean
+fm350gl_parse_epbseh (const gchar *response,
+                      gchar      **gsm,
+                      guint32     *umts,
+                      guint32      lte[4],
+                      guint32      nr[4],
+                      GError     **error)
+{
+    gchar **parts;
+    gchar *fields[4] = { NULL };
+    guint i;
+
+    response = mm_strip_tag (response, "+EPBSEH: ");
+    parts = g_strsplit (response, ",", -1);
+
+    if (g_strv_length (parts) != 4) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                     "Failed to parse +EPBSEH response");
+        g_strfreev (parts);
+        return FALSE;
+    }
+
+    for (i = 0; i < 4; i++)
+        fields[i] = fm350gl_clean_epbseh_field (parts[i]);
+
+    if (gsm)
+        *gsm = g_strdup (fields[0]);
+
+    if (!fm350gl_parse_hex_u32 (fields[1], umts)) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                     "Failed to parse +EPBSEH UMTS bitmap");
+        goto out;
+    }
+
+    if (!fm350gl_parse_hex_bitmap (fields[2], lte)) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                     "Failed to parse +EPBSEH LTE bitmap");
+        goto out;
+    }
+
+    if (!fm350gl_parse_hex_bitmap (fields[3], nr)) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                     "Failed to parse +EPBSEH NR bitmap");
+        goto out;
+    }
+
+    for (i = 0; i < 4; i++)
+        g_free (fields[i]);
+    g_strfreev (parts);
+    return TRUE;
+
+out:
+    if (gsm) {
+        g_clear_pointer (gsm, g_free);
+    }
+    for (i = 0; i < 4; i++)
+        g_free (fields[i]);
+    g_strfreev (parts);
+    return FALSE;
+}
