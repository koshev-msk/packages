+static void
+enabling_modem_init(MMBroadbandModem* self,
+    GAsyncReadyCallback  callback,
+    gpointer             user_data)
+{
+    MMPortSerialAt* primary;
+
+    primary = mm_base_modem_peek_port_primary(MM_BASE_MODEM(self));
+    if (!primary) {
+        g_task_report_new_error(self, callback, user_data, enabling_modem_init,
+            MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+            "Failed to run init command: primary port missing");
+        return;
+    }
+    mm_base_modem_at_command_full(MM_BASE_MODEM(self), MM_IFACE_PORT_AT (primary), "Z0", 6, FALSE, FALSE, NULL, /* cancellable */ callback, user_data);
+}
