+        case 48: return MM_MODEM_BAND_NGRAN_48;
+        case 50: return MM_MODEM_BAND_NGRAN_50;
+        case 51: return MM_MODEM_BAND_NGRAN_51;
+        case 53: return MM_MODEM_BAND_NGRAN_53;
+        case 65: return MM_MODEM_BAND_NGRAN_65;
