+    g_free (ctx);
+}
+
+static void
+set_current_bands_get_current (MMBaseModem *self,
+                               GAsyncResult *res,
+                               GTask *task)
+{
+    SetCurrentBandsContext *ctx;
+    const gchar *response;
+    GError *error = NULL;
+    gchar *gsm = NULL;
+    guint32 umts = 0;
+    guint32 lte[4] = { 0, 0, 0, 0 };
+    guint32 nr[4] = { 0, 0, 0, 0 };
+    guint i;
+    GString *command;
+
+    ctx = g_task_get_task_data (task);
+    response = mm_base_modem_at_command_finish (MM_BASE_MODEM (self), res, &error);
+    if (!response) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    if (!fm350gl_parse_epbseh (response, &gsm, &umts, lte, nr, &error)) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    umts = 0;
+    lte[0] = lte[1] = 0;
+    nr[0] = nr[1] = nr[2] = nr[3] = 0;
+
+    for (i = 0; i < ctx->bands->len; i++) {
+        MMModemBand band = g_array_index (ctx->bands, MMModemBand, i);
+        guint number = fm350gl_band_number (band);
+
+        if (!number)
+            continue;
+
+        switch (band) {
+        case MM_MODEM_BAND_UTRAN_1:
+        case MM_MODEM_BAND_UTRAN_2:
+        case MM_MODEM_BAND_UTRAN_3:
+        case MM_MODEM_BAND_UTRAN_4:
+        case MM_MODEM_BAND_UTRAN_5:
+        case MM_MODEM_BAND_UTRAN_6:
+        case MM_MODEM_BAND_UTRAN_7:
+        case MM_MODEM_BAND_UTRAN_8:
+        case MM_MODEM_BAND_UTRAN_9:
+        case MM_MODEM_BAND_UTRAN_10:
+        case MM_MODEM_BAND_UTRAN_11:
+        case MM_MODEM_BAND_UTRAN_12:
+        case MM_MODEM_BAND_UTRAN_13:
+        case MM_MODEM_BAND_UTRAN_14:
+        case MM_MODEM_BAND_UTRAN_19:
+        case MM_MODEM_BAND_UTRAN_20:
+        case MM_MODEM_BAND_UTRAN_21:
+        case MM_MODEM_BAND_UTRAN_22:
+        case MM_MODEM_BAND_UTRAN_25:
+        case MM_MODEM_BAND_UTRAN_26:
+        case MM_MODEM_BAND_UTRAN_32:
+            umts |= 1U << (number - 1);
+            break;
+
+        case MM_MODEM_BAND_EUTRAN_1:
+        case MM_MODEM_BAND_EUTRAN_2:
+        case MM_MODEM_BAND_EUTRAN_3:
+        case MM_MODEM_BAND_EUTRAN_4:
+        case MM_MODEM_BAND_EUTRAN_5:
+        case MM_MODEM_BAND_EUTRAN_6:
+        case MM_MODEM_BAND_EUTRAN_7:
+        case MM_MODEM_BAND_EUTRAN_8:
+        case MM_MODEM_BAND_EUTRAN_9:
+        case MM_MODEM_BAND_EUTRAN_10:
+        case MM_MODEM_BAND_EUTRAN_11:
+        case MM_MODEM_BAND_EUTRAN_12:
+        case MM_MODEM_BAND_EUTRAN_13:
+        case MM_MODEM_BAND_EUTRAN_14:
+        case MM_MODEM_BAND_EUTRAN_17:
+        case MM_MODEM_BAND_EUTRAN_18:
+        case MM_MODEM_BAND_EUTRAN_19:
+        case MM_MODEM_BAND_EUTRAN_20:
+        case MM_MODEM_BAND_EUTRAN_21:
+        case MM_MODEM_BAND_EUTRAN_22:
+        case MM_MODEM_BAND_EUTRAN_23:
+        case MM_MODEM_BAND_EUTRAN_24:
+        case MM_MODEM_BAND_EUTRAN_25:
+        case MM_MODEM_BAND_EUTRAN_26:
+        case MM_MODEM_BAND_EUTRAN_27:
+        case MM_MODEM_BAND_EUTRAN_28:
+        case MM_MODEM_BAND_EUTRAN_29:
+        case MM_MODEM_BAND_EUTRAN_30:
+        case MM_MODEM_BAND_EUTRAN_31:
+        case MM_MODEM_BAND_EUTRAN_32:
+        case MM_MODEM_BAND_EUTRAN_33:
+        case MM_MODEM_BAND_EUTRAN_34:
+        case MM_MODEM_BAND_EUTRAN_35:
+        case MM_MODEM_BAND_EUTRAN_36:
+        case MM_MODEM_BAND_EUTRAN_37:
+        case MM_MODEM_BAND_EUTRAN_38:
+        case MM_MODEM_BAND_EUTRAN_39:
+        case MM_MODEM_BAND_EUTRAN_40:
+        case MM_MODEM_BAND_EUTRAN_41:
+        case MM_MODEM_BAND_EUTRAN_42:
+        case MM_MODEM_BAND_EUTRAN_43:
+        case MM_MODEM_BAND_EUTRAN_44:
+        case MM_MODEM_BAND_EUTRAN_45:
+        case MM_MODEM_BAND_EUTRAN_46:
+        case MM_MODEM_BAND_EUTRAN_47:
+        case MM_MODEM_BAND_EUTRAN_48:
+        case MM_MODEM_BAND_EUTRAN_49:
+        case MM_MODEM_BAND_EUTRAN_50:
+        case MM_MODEM_BAND_EUTRAN_51:
+        case MM_MODEM_BAND_EUTRAN_52:
+        case MM_MODEM_BAND_EUTRAN_53:
+        case MM_MODEM_BAND_EUTRAN_54:
+        case MM_MODEM_BAND_EUTRAN_55:
+        case MM_MODEM_BAND_EUTRAN_56:
+        case MM_MODEM_BAND_EUTRAN_57:
+        case MM_MODEM_BAND_EUTRAN_58:
+        case MM_MODEM_BAND_EUTRAN_59:
+        case MM_MODEM_BAND_EUTRAN_60:
+        case MM_MODEM_BAND_EUTRAN_61:
+        case MM_MODEM_BAND_EUTRAN_62:
+        case MM_MODEM_BAND_EUTRAN_63:
+        case MM_MODEM_BAND_EUTRAN_64: {
+            guint index = number - 1;
+            lte[index / 32] |= 1U << (index % 32);
+            break;
+        }
+
+        case MM_MODEM_BAND_NGRAN_1:
+        case MM_MODEM_BAND_NGRAN_2:
+        case MM_MODEM_BAND_NGRAN_3:
+        case MM_MODEM_BAND_NGRAN_5:
+        case MM_MODEM_BAND_NGRAN_7:
+        case MM_MODEM_BAND_NGRAN_8:
+        case MM_MODEM_BAND_NGRAN_12:
+        case MM_MODEM_BAND_NGRAN_13:
+        case MM_MODEM_BAND_NGRAN_14:
+        case MM_MODEM_BAND_NGRAN_18:
+        case MM_MODEM_BAND_NGRAN_20:
+        case MM_MODEM_BAND_NGRAN_25:
+        case MM_MODEM_BAND_NGRAN_26:
+        case MM_MODEM_BAND_NGRAN_28:
+        case MM_MODEM_BAND_NGRAN_29:
+        case MM_MODEM_BAND_NGRAN_30:
+        case MM_MODEM_BAND_NGRAN_34:
+        case MM_MODEM_BAND_NGRAN_38:
+        case MM_MODEM_BAND_NGRAN_39:
+        case MM_MODEM_BAND_NGRAN_40:
+        case MM_MODEM_BAND_NGRAN_41:
+        case MM_MODEM_BAND_NGRAN_48:
+        case MM_MODEM_BAND_NGRAN_50:
+        case MM_MODEM_BAND_NGRAN_51:
+        case MM_MODEM_BAND_NGRAN_53:
+        case MM_MODEM_BAND_NGRAN_65:
+        case MM_MODEM_BAND_NGRAN_66:
+        case MM_MODEM_BAND_NGRAN_67:
+        case MM_MODEM_BAND_NGRAN_70:
+        case MM_MODEM_BAND_NGRAN_71:
+        case MM_MODEM_BAND_NGRAN_74:
+        case MM_MODEM_BAND_NGRAN_75:
+        case MM_MODEM_BAND_NGRAN_76:
+        case MM_MODEM_BAND_NGRAN_77:
+        case MM_MODEM_BAND_NGRAN_78:
+        case MM_MODEM_BAND_NGRAN_79:
+        case MM_MODEM_BAND_NGRAN_80:
+        case MM_MODEM_BAND_NGRAN_81:
+        case MM_MODEM_BAND_NGRAN_82:
+        case MM_MODEM_BAND_NGRAN_83:
+        case MM_MODEM_BAND_NGRAN_84:
+        case MM_MODEM_BAND_NGRAN_86:
+        case MM_MODEM_BAND_NGRAN_89:
+        case MM_MODEM_BAND_NGRAN_90:
+        case MM_MODEM_BAND_NGRAN_91:
+        case MM_MODEM_BAND_NGRAN_92:
+        case MM_MODEM_BAND_NGRAN_93:
+        case MM_MODEM_BAND_NGRAN_94:
+        case MM_MODEM_BAND_NGRAN_95: {
+            guint index = number - 1;
+            nr[index / 32] |= 1U << (index % 32);
+            break;
+        }
+
+        default:
+            break;
+        }
+    }
+
+    command = g_string_new ("AT+EPBSEH=\"");
+    g_string_append (command, gsm);
+    g_string_append (command, "\",");
+    g_string_append_printf (command, "\"%08X\",", umts);
+    g_string_append_printf (command, "\"%08X%08X%08X%08X\",", lte[0], lte[1], lte[2], lte[3]);
+    g_string_append_printf (command, "\"%08X%08X%08X%08X\"", nr[0], nr[1], nr[2], nr[3]);
+
+    g_free (gsm);
+
+    mm_base_modem_at_command (MM_BASE_MODEM (self),
+                              command->str,
+                              3,
+                              TRUE,
+                              (GAsyncReadyCallback) set_current_bands_set_finish,
+                              task);
+    g_string_free (command, TRUE);
+}
+
+static void
+set_current_bands (MMIfaceModem *self,
+                   GArray *bands_array,
+                   GAsyncReadyCallback callback,
+                   gpointer user_data)
+{
+    GTask *task;
+    SetCurrentBandsContext *ctx;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    ctx = g_new0 (SetCurrentBandsContext, 1);
+    ctx->bands = g_array_ref (bands_array);
+    g_task_set_task_data (task, ctx, (GDestroyNotify) set_current_bands_context_free);
+
+    mm_base_modem_at_command (MM_BASE_MODEM (self),
+                              "+EPBSEH?",
+                              3,
+                              TRUE,
+                              (GAsyncReadyCallback) set_current_bands_get_current,
+                              task);
+}
