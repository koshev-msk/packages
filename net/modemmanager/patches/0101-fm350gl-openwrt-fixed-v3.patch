+static void
+fm350gl_append_bitmap_bands (GArray          *bands,
+                             guint32          mask,
+                             guint             first_band,
+                             FM350GLBandType  type)
+{
+    guint i;
+
+    for (i = 0; i < 32; i++) {
+        MMModemBand band;
+
+        if (!(mask & (1U << i)))
+            continue;
+
+        band = fm350gl_band_from_number (type, first_band + i);
+        if (band != MM_MODEM_BAND_UNKNOWN)
+            g_array_append_val (bands, band);
+    }
+}
+
+static GArray *
+fm350gl_epbseh_response_to_bands (const gchar *response,
+                                  GError     **error)
+{
+    gchar *gsm = NULL;
+    guint32 umts;
+    guint32 lte[4];
+    guint32 nr[4];
+    GArray *bands;
+
+    if (!fm350gl_parse_epbseh (response, &gsm, &umts, lte, nr, error))
+        return NULL;
+
+    g_free (gsm);
+    bands = g_array_new (FALSE, FALSE, sizeof (MMModemBand));
+
+    fm350gl_append_bitmap_bands (bands, umts, 1, FM350GL_BAND_TYPE_UTRAN);
+    fm350gl_append_bitmap_bands (bands, lte[0], 1, FM350GL_BAND_TYPE_EUTRAN);
+    fm350gl_append_bitmap_bands (bands, lte[1], 33, FM350GL_BAND_TYPE_EUTRAN);
+    fm350gl_append_bitmap_bands (bands, nr[0], 1, FM350GL_BAND_TYPE_NGRAN);
+    fm350gl_append_bitmap_bands (bands, nr[1], 33, FM350GL_BAND_TYPE_NGRAN);
+    fm350gl_append_bitmap_bands (bands, nr[2], 65, FM350GL_BAND_TYPE_NGRAN);
+    fm350gl_append_bitmap_bands (bands, nr[3], 97, FM350GL_BAND_TYPE_NGRAN);
+
+    return bands;
+}
