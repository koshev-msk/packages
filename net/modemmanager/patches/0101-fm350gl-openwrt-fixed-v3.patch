+        case 20: return MM_MODEM_BAND_NGRAN_20;
+        case 25: return MM_MODEM_BAND_NGRAN_25;
+        case 26: return MM_MODEM_BAND_NGRAN_26;
+        case 28: return MM_MODEM_BAND_NGRAN_28;
+        case 29: return MM_MODEM_BAND_NGRAN_29;
+        case 30: return MM_MODEM_BAND_NGRAN_30;
+        case 34: return MM_MODEM_BAND_NGRAN_34;
+        case 38: return MM_MODEM_BAND_NGRAN_38;
