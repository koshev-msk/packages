+        case 6:  return MM_MODEM_BAND_UTRAN_6;
+        case 7:  return MM_MODEM_BAND_UTRAN_7;
+        case 8:  return MM_MODEM_BAND_UTRAN_8;
+        case 9:  return MM_MODEM_BAND_UTRAN_9;
+        case 10: return MM_MODEM_BAND_UTRAN_10;
+        case 11: return MM_MODEM_BAND_UTRAN_11;
+        case 12: return MM_MODEM_BAND_UTRAN_12;
+        case 13: return MM_MODEM_BAND_UTRAN_13;
+        case 14: return MM_MODEM_BAND_UTRAN_14;
+        case 19: return MM_MODEM_BAND_UTRAN_19;
+        case 20: return MM_MODEM_BAND_UTRAN_20;
+        case 21: return MM_MODEM_BAND_UTRAN_21;
+        case 22: return MM_MODEM_BAND_UTRAN_22;
+        case 25: return MM_MODEM_BAND_UTRAN_25;
+        case 26: return MM_MODEM_BAND_UTRAN_26;
+        case 32: return MM_MODEM_BAND_UTRAN_32;
+        default: return MM_MODEM_BAND_UNKNOWN;
+        }
+
+    case FM350GL_BAND_TYPE_EUTRAN:
+        if (number >= 1 && number <= 14)
+            return MM_MODEM_BAND_EUTRAN_1 + (number - 1);
+        if (number >= 17 && number <= 64)
+            return MM_MODEM_BAND_EUTRAN_17 + (number - 17);
+        return MM_MODEM_BAND_UNKNOWN;
+
+    case FM350GL_BAND_TYPE_NGRAN:
