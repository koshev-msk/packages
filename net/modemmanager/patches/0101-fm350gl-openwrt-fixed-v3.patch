+        case 70: return MM_MODEM_BAND_NGRAN_70;
+        case 71: return MM_MODEM_BAND_NGRAN_71;
+        case 74: return MM_MODEM_BAND_NGRAN_74;
+        case 75: return MM_MODEM_BAND_NGRAN_75;
+        case 76: return MM_MODEM_BAND_NGRAN_76;
+        case 77: return MM_MODEM_BAND_NGRAN_77;
