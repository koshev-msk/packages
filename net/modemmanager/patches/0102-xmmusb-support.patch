diff --git a/src/plugins/xmmusb/77-mm-xmmusb.rules b/src/plugins/xmmusb/77-mm-xmmusb.rules
new file mode 100644
index 0000000..35b72ef
--- /dev/null
+++ b/src/plugins/xmmusb/77-mm-xmmusb.rules
@@ -0,0 +1,23 @@
+# /lib/udev/rules.d/77-mm-xmmusb.rules
+#
+# Interface layout confirmed from `lsusb -v` on Intel 8087:095a
+# (Fibocom L860-GL / Intel XMM7360, plain-USB CDC-ACM+CDC-NCM variant):
+#   if 00 -> CDC-ACM control (AT primary: AT+CMEE, AT+COPS, AT+CGDCONT...)
+#   if 02 -> CDC-ACM control (AT secondary: AT+XDNS)
+#   if 04 -> CDC-ACM control (unused - diagnostic/log port, ignored)
+#   if 06/08/10 -> CDC-NCM (net data, no tty node created)
+
+ACTION!="add|change|move|bind", GOTO="mm_xmmusb_port_types_end"
+SUBSYSTEMS=="usb", ATTRS{idVendor}=="8087", ATTRS{idProduct}=="095a", GOTO="mm_xmmusb_port_types_vendorcheck"
+GOTO="mm_xmmusb_port_types_end"
+
+LABEL="mm_xmmusb_port_types_vendorcheck"
+SUBSYSTEMS=="usb", ATTRS{bInterfaceNumber}=="?*", ENV{.MM_USBIFNUM}="$attr{bInterfaceNumber}"
+
+ENV{.MM_USBIFNUM}=="00", SUBSYSTEM=="tty", ENV{ID_MM_PORT_TYPE_AT_PRIMARY}="1"
+ENV{.MM_USBIFNUM}=="02", SUBSYSTEM=="tty", ENV{ID_MM_PORT_TYPE_AT_SECONDARY}="1"
+ENV{.MM_USBIFNUM}=="04", SUBSYSTEM=="tty", ENV{ID_MM_PORT_IGNORE}="1"
+
+GOTO="mm_xmmusb_port_types_end"
+
+LABEL="mm_xmmusb_port_types_end"
diff --git a/src/plugins/xmmusb/mm-broadband-bearer-xmmusb.c b/src/plugins/xmmusb/mm-broadband-bearer-xmmusb.c
new file mode 100644
index 0000000..58a2e40
--- /dev/null
+++ b/src/plugins/xmmusb/mm-broadband-bearer-xmmusb.c
@@ -0,0 +1,833 @@
+/*
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details:
+ *
+ * Dial sequence based on the userspace xmm7360-pci "open_xdatachannel.py"
+ * flow, ported here for the plain-USB CDC-ACM+CDC-NCM variant of the
+ * Intel XMM7360 modem (as opposed to the PCIe/iosm/wwan-RPC variant that
+ * upstream ModemManager's 'intel' plugin already supports since 1.26).
+ */
+
+#include <config.h>
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <string.h>
+#include <ctype.h>
+
+#include <ModemManager.h>
+#define _LIBMM_INSIDE_MM
+#include <libmm-glib.h>
+
+#include "mm-base-modem-at.h"
+#include "mm-broadband-bearer-xmmusb.h"
+#include "mm-log-object.h"
+
+/* USB function path strings used by the XMM7360 RPC/AT firmware to bind
+ * the AT control channel to the CDC-NCM data channel. These match what
+ * the modem itself reports in its endpoint descriptors ("/USBCDC/0",
+ * "/USBHS/NCM/0") and are constant across USB variants of this chipset. */
+#define XMMUSB_CDC_PATH "/USBCDC/0"
+#define XMMUSB_NCM_PATH "/USBHS/NCM/0"
+
+static MMPort * dial_3gpp_finish (MMBroadbandBearer *self, GAsyncResult *res, GError **error);
+static void dial_3gpp (MMBroadbandBearer *self, MMBaseModem *modem, MMPortSerialAt *primary, guint cid, GCancellable *cancellable, GAsyncReadyCallback callback, gpointer user_data);
+static void get_ip_config_3gpp (MMBroadbandBearer *self, MMBroadbandModem *modem, MMPortSerialAt *primary, MMPortSerialAt *secondary, MMPort *data, guint cid, MMBearerIpFamily ip_family, GAsyncReadyCallback callback, gpointer user_data);
+static gboolean get_ip_config_3gpp_finish (MMBroadbandBearer *self, GAsyncResult *res, MMBearerIpConfig **ipv4_config, MMBearerIpConfig **ipv6_config, GError **error);
+static void disconnect_3gpp (MMBroadbandBearer *self, MMBroadbandModem *modem, MMPortSerialAt *primary, MMPortSerialAt *secondary, MMPort *data, guint cid, GAsyncReadyCallback callback, gpointer user_data);
+static gboolean parse_ip (const gchar *response, MMBearerIpConfig *out_ip4_config, MMBearerIpConfig *out_ip6_config, GError **error);
+static void deztohexip (gchar *dezstring, GString *output);
+
+G_DEFINE_TYPE (MMBroadbandBearerXmmUsb, mm_broadband_bearer_xmmusb, MM_TYPE_BROADBAND_BEARER);
+
+struct _MMBroadbandBearerXmmUsbPrivate {
+    MMPort *port;
+};
+
+/*****************************************************************************/
+/* Construction */
+
+void
+mm_broadband_bearer_xmmusb_new (MMBroadbandModem *modem,
+                                 MMBearerProperties *bearer_properties,
+                                 GCancellable *cancellable,
+                                 GAsyncReadyCallback callback,
+                                 gpointer user_data)
+{
+    g_async_initable_new_async (
+        MM_TYPE_BROADBAND_BEARER_XMMUSB,
+        G_PRIORITY_DEFAULT,
+        cancellable,
+        callback,
+        user_data,
+        MM_BASE_BEARER_MODEM,  modem,
+        MM_BASE_BEARER_CONFIG, bearer_properties,
+        NULL);
+}
+
+MMBaseBearer *
+mm_broadband_bearer_xmmusb_new_finish (GAsyncResult *res,
+                                        GError **error)
+{
+    GObject *bearer;
+    GObject *source;
+
+    source = g_async_result_get_source_object (res);
+    bearer = g_async_initable_new_finish (G_ASYNC_INITABLE (source), res, error);
+    g_object_unref (source);
+
+    if (!bearer)
+        return NULL;
+
+    mm_base_bearer_export (MM_BASE_BEARER (bearer));
+    return MM_BASE_BEARER (bearer);
+}
+
+/*****************************************************************************/
+/* Dial (3GPP) - full sequence matching the working xmm-connect.gcom:
+ *   AT+CGDCONT=<cid>                       (clear any stale definition)
+ *   AT+CGDCONT=<cid>,"<pdp>","<apn>"       (define APN for OUR cid)
+ *   AT+CGACT=1,<cid>                       (activate the context)
+ *   AT+XDATACHANNEL=1,1,"<at>","<ncm>",2,<cid>
+ *   AT+CGDATA="M-RAW_IP",<cid>
+ *
+ * The cid MM allocates for this bearer is generally NOT the same cid
+ * used by the initial EPS default bearer that comes up automatically
+ * on network attach - that one is already active, but our own cid
+ * has no APN definition and no active context unless we activate it
+ * ourselves here. Skipping CGDCONT/CGACT lets XDATACHANNEL/CGDATA
+ * "succeed" against a nonexistent context: MM reports connected, but
+ * no traffic ever flows over the NCM interface. */
+
+typedef struct {
+    MMBaseModem *modem;
+    MMPortSerialAt *primary;
+    guint cid;
+} Dial3gppContext;
+
+static void
+dial_3gpp_context_free (Dial3gppContext *ctx)
+{
+    g_object_unref (ctx->primary);
+    g_object_unref (ctx->modem);
+    g_slice_free (Dial3gppContext, ctx);
+}
+
+static MMPort *
+dial_3gpp_finish (MMBroadbandBearer *self,
+                   GAsyncResult *res,
+                   GError **error)
+{
+    return g_task_propagate_pointer (G_TASK (res), error);
+}
+
+static void
+cgdata_ready (MMBaseModem *modem,
+              GAsyncResult *res,
+              GTask *task)
+{
+    GError *error = NULL;
+
+    if (!mm_base_modem_at_command_full_finish (modem, res, &error)) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+    /* ARP disable on net ifaces */
+    MMPort *net_port = mm_base_modem_peek_best_data_port (modem, MM_PORT_TYPE_NET);
+    if (net_port) {
+        const char *iface = mm_port_get_device (net_port);
+        if (iface && *iface) {
+            gchar *cmd = g_strdup_printf ("/sbin/ip link set dev %s arp off", iface);
+            if (g_spawn_command_line_async (cmd, NULL)) {
+                mm_obj_dbg (modem, "ARP disabled on interface %s", iface);
+            } else {
+                mm_obj_dbg (modem, "Failed to disable ARP on interface %s", iface);
+            }
+            g_free (cmd);
+        }
+    }
+
+
+    /* Data now flows over the CDC-NCM interface; hand back the net port
+     * ModemManager already associated with this modem. */
+    g_task_return_pointer (task,
+                            g_object_ref (mm_base_modem_peek_best_data_port (modem, MM_PORT_TYPE_NET)),
+                            g_object_unref);
+    g_object_unref (task);
+}
+
+static void
+xdatachannel_ready (MMBaseModem *modem,
+                     GAsyncResult *res,
+                     GTask *task)
+{
+    Dial3gppContext *ctx;
+    GError *error = NULL;
+    gchar *command;
+
+    ctx = g_task_get_task_data (task);
+
+    if (!mm_base_modem_at_command_full_finish (modem, res, &error)) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    /* Switch the PDP context into raw-IP data mode over the channel we
+     * just bound above. */
+    command = g_strdup_printf ("+CGDATA=\"M-RAW_IP\",%d", ctx->cid);
+    mm_base_modem_at_command_full (ctx->modem,
+                                    MM_IFACE_PORT_AT (ctx->primary),
+                                    command,
+                                    MM_BASE_BEARER_DEFAULT_CONNECTION_TIMEOUT,
+                                    FALSE,
+                                    FALSE, /* raw */
+                                    NULL, /* cancellable */
+                                    (GAsyncReadyCallback) cgdata_ready,
+                                    task);
+    g_free (command);
+}
+
+static void
+cgact_ready (MMBaseModem *modem,
+             GAsyncResult *res,
+             GTask *task)
+{
+    Dial3gppContext *ctx;
+    GError *error = NULL;
+    gchar *command;
+
+    ctx = g_task_get_task_data (task);
+
+    if (!mm_base_modem_at_command_full_finish (modem, res, &error)) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    command = g_strdup_printf ("+XDATACHANNEL=1,1,\"%s\",\"%s\",2,%d",
+                                XMMUSB_CDC_PATH, XMMUSB_NCM_PATH, ctx->cid);
+    mm_base_modem_at_command_full (ctx->modem,
+                                    MM_IFACE_PORT_AT (ctx->primary),
+                                    command,
+                                    MM_BASE_BEARER_DEFAULT_CONNECTION_TIMEOUT,
+                                    FALSE,
+                                    FALSE, /* raw */
+                                    NULL, /* cancellable */
+                                    (GAsyncReadyCallback) xdatachannel_ready,
+                                    task);
+    g_free (command);
+}
+
+static void
+cgdcont_set_ready (MMBaseModem *modem,
+                    GAsyncResult *res,
+                    GTask *task)
+{
+    Dial3gppContext *ctx;
+    GError *error = NULL;
+    gchar *command;
+
+    ctx = g_task_get_task_data (task);
+
+    if (!mm_base_modem_at_command_full_finish (modem, res, &error)) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    command = g_strdup_printf ("+CGACT=1,%d", ctx->cid);
+    mm_base_modem_at_command_full (ctx->modem,
+                                    MM_IFACE_PORT_AT (ctx->primary),
+                                    command,
+                                    MM_BASE_BEARER_DEFAULT_CONNECTION_TIMEOUT,
+                                    FALSE,
+                                    FALSE, /* raw */
+                                    NULL, /* cancellable */
+                                    (GAsyncReadyCallback) cgact_ready,
+                                    task);
+    g_free (command);
+}
+
+static void
+cgdcont_clear_ready (MMBaseModem *modem,
+                      GAsyncResult *res,
+                      GTask *task)
+{
+    Dial3gppContext *ctx;
+    MMBearerProperties *props;
+    const gchar *apn;
+    MMBearerIpFamily ip_family;
+    const gchar *pdp;
+    gchar *command;
+
+    /* Not fatal if clearing an unset context definition errors out. */
+    mm_base_modem_at_command_full_finish (modem, res, NULL);
+
+    ctx = g_task_get_task_data (task);
+
+    props = mm_base_bearer_peek_config (MM_BASE_BEARER (g_task_get_source_object (task)));
+    apn = props ? mm_bearer_properties_get_apn (props) : NULL;
+    ip_family = props ? mm_bearer_properties_get_ip_type (props) : MM_BEARER_IP_FAMILY_IPV4;
+
+    switch (ip_family) {
+        case MM_BEARER_IP_FAMILY_IPV6:
+            pdp = "IPV6";
+            break;
+        case MM_BEARER_IP_FAMILY_IPV4V6:
+            pdp = "IPV4V6";
+            break;
+        default:
+            pdp = "IP";
+            break;
+    }
+
+    command = g_strdup_printf ("+CGDCONT=%d,\"%s\",\"%s\"", ctx->cid, pdp, apn ? apn : "");
+    mm_base_modem_at_command_full (ctx->modem,
+                                    MM_IFACE_PORT_AT (ctx->primary),
+                                    command,
+                                    MM_BASE_BEARER_DEFAULT_CONNECTION_TIMEOUT,
+                                    FALSE,
+                                    FALSE, /* raw */
+                                    NULL, /* cancellable */
+                                    (GAsyncReadyCallback) cgdcont_set_ready,
+                                    task);
+    g_free (command);
+}
+
+static void
+dial_3gpp (MMBroadbandBearer *self,
+           MMBaseModem *modem,
+           MMPortSerialAt *primary,
+           guint cid,
+           GCancellable *cancellable,
+           GAsyncReadyCallback callback,
+           gpointer user_data)
+{
+    Dial3gppContext *ctx;
+    GTask *task;
+    gchar *command;
+
+    g_assert (primary != NULL);
+
+    ctx = g_slice_new0 (Dial3gppContext);
+    ctx->modem = g_object_ref (modem);
+    ctx->primary = g_object_ref (primary);
+    ctx->cid = cid;
+
+    task = g_task_new (self, cancellable, callback, user_data);
+    g_task_set_task_data (task, ctx, (GDestroyNotify) dial_3gpp_context_free);
+
+    /* Clear any stale APN definition on our cid first - mirrors
+     * "AT+CGDCONT=<cid>" (no value part) in xmm-connect.gcom. */
+    command = g_strdup_printf ("+CGDCONT=%d", cid);
+    mm_base_modem_at_command_full (ctx->modem,
+                                    MM_IFACE_PORT_AT (ctx->primary),
+                                    command,
+                                    MM_BASE_BEARER_DEFAULT_CONNECTION_TIMEOUT,
+                                    FALSE,
+                                    FALSE, /* raw */
+                                    NULL, /* cancellable */
+                                    (GAsyncReadyCallback) cgdcont_clear_ready,
+                                    task);
+    g_free (command);
+}
+
+/*****************************************************************************/
+/* Disconnect (3GPP) - matches xmm-disconnect.gcom exactly:
+ *   AT+CGACT=0,<cid>     (deactivate the context FIRST)
+ *   AT+XDATACHANNEL=0    (bare command, no path/cid arguments at all)
+ *
+ * Confirmed against the working userspace script: the order is the
+ * reverse of what you might expect from dial_3gpp, and XDATACHANNEL=0
+ * takes no other arguments on teardown. */
+
+typedef struct {
+    MMBaseModem *modem;
+    MMPortSerialAt *primary;
+    guint cid;
+} Disconnect3gppContext;
+
+static void
+disconnect_3gpp_context_free (Disconnect3gppContext *ctx)
+{
+    g_object_unref (ctx->primary);
+    g_object_unref (ctx->modem);
+    g_slice_free (Disconnect3gppContext, ctx);
+}
+
+static void
+xdatachannel_disconnect_ready (MMBaseModem *modem,
+                                GAsyncResult *res,
+                                GTask *task)
+{
+    GError *error = NULL;
+
+    if (!mm_base_modem_at_command_full_finish (modem, res, &error)) {
+        mm_obj_dbg (g_task_get_source_object (task),
+                    "XDATACHANNEL teardown failed (not fatal): %s", error->message);
+        g_error_free (error);
+    }
+
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+cgact_disconnect_ready (MMBaseModem *modem,
+                         GAsyncResult *res,
+                         GTask *task)
+{
+    Disconnect3gppContext *ctx;
+    GError *error = NULL;
+
+    ctx = g_task_get_task_data (task);
+
+    if (!mm_base_modem_at_command_full_finish (modem, res, &error)) {
+        /* Not fatal: still try to unbind the data channel below. */
+        mm_obj_dbg (g_task_get_source_object (task),
+                    "PDP context deactivation failed (continuing with XDATACHANNEL=0): %s", error->message);
+        g_error_free (error);
+    }
+
+    mm_base_modem_at_command_full (ctx->modem,
+                                    MM_IFACE_PORT_AT (ctx->primary),
+                                    "+XDATACHANNEL=0",
+                                    45,
+                                    FALSE,
+                                    FALSE, /* raw */
+                                    NULL, /* cancellable */
+                                    (GAsyncReadyCallback) xdatachannel_disconnect_ready,
+                                    task);
+}
+
+static void
+disconnect_3gpp (MMBroadbandBearer *self,
+                  MMBroadbandModem *modem,
+                  MMPortSerialAt *primary,
+                  MMPortSerialAt *secondary,
+                  MMPort *data,
+                  guint cid,
+                  GAsyncReadyCallback callback,
+                  gpointer user_data)
+{
+    Disconnect3gppContext *ctx;
+    GTask *task;
+    gchar *command;
+
+    g_assert (primary != NULL);
+
+    ctx = g_slice_new0 (Disconnect3gppContext);
+    ctx->modem = MM_BASE_MODEM (g_object_ref (modem));
+    ctx->primary = g_object_ref (primary);
+    ctx->cid = cid;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    g_task_set_task_data (task, ctx, (GDestroyNotify) disconnect_3gpp_context_free);
+
+    command = g_strdup_printf ("+CGACT=0,%d", cid);
+    mm_base_modem_at_command_full (ctx->modem,
+                                    MM_IFACE_PORT_AT (primary),
+                                    command,
+                                    45,
+                                    FALSE,
+                                    FALSE, /* raw */
+                                    NULL, /* cancellable */
+                                    (GAsyncReadyCallback) cgact_disconnect_ready,
+                                    task);
+    g_free (command);
+}
+
+/*****************************************************************************/
+/* IP config (3GPP) - identical AT+CGPADDR / AT+CGCONTRDP flow as used in
+ * the fm350gl bearer; these are plain 3GPP TS 27.007 commands, not
+ * XMM7360-specific, so the parsing logic is reused as-is. */
+
+static void
+deztohexip (gchar *dezstring, GString *output)
+{
+    GString *dstr = g_string_new (dezstring);
+    gchar **parts;
+    int c, i;
+
+    parts = g_strsplit (dstr->str, ".", -1);
+    c = g_strv_length (parts);
+
+    for (i = 0; i < c; i++) {
+        if (i == 0)
+            g_string_append_printf (output, "%02x", atoi (parts[i]));
+        else {
+            if (i % 2 == 0)
+                g_string_append (output, ":");
+            g_string_append_printf (output, "%02x", atoi (parts[i]));
+        }
+    }
+    g_strfreev (parts);
+    g_string_free (dstr, TRUE);
+}
+
+static gchar *
+first_four_octets (gchar **octets, guint n)
+{
+    /* On this modem AT+CGPADDR (and AT+CGCONTRDP's local_addr field)
+     * report the IPv4 address with the subnet mask concatenated onto
+     * it as 4 more dotted octets - "10.14.25.48.255.0.0.0" means
+     * address 10.14.25.48, mask 255.0.0.0, not an 8-octet address.
+     * Take just the first 4 octets as the real address. */
+    if (n < 4)
+        return NULL;
+    return g_strdup_printf ("%s.%s.%s.%s", octets[0], octets[1], octets[2], octets[3]);
+}
+
+static gboolean
+parse_ip (const gchar *response,
+          MMBearerIpConfig *out_ip4_config,
+          MMBearerIpConfig *out_ip6_config,
+          GError **error)
+{
+    gchar **data;
+    gchar **data1;
+    gchar **data2;
+    gchar *ip1;
+    gchar *ip2;
+    gchar *ipv4;
+    gchar *ipv6;
+    GString *gstmp;
+    int c;
+    GString *s;
+
+    g_return_val_if_fail (out_ip4_config, FALSE);
+    g_return_val_if_fail (out_ip6_config, FALSE);
+
+    if (!response || !g_str_has_prefix (response, "+CGPADDR")) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED, "Missing +CGPADDR prefix");
+        return FALSE;
+    }
+
+    response = mm_strip_tag (response, "+CGPADDR: ");
+
+    s = g_string_new (response);
+    g_string_replace (s, "\"", "", -1);
+    data = g_strsplit (s->str, ",", -1);
+    c = g_strv_length (data);
+
+    if (c != 2 && c != 3) {
+        g_set_error_literal (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED, "Couldn't match +CGPADDR reply");
+        g_strfreev (data);
+        g_string_free (s, TRUE);
+        return FALSE;
+    }
+
+    ipv4 = NULL;
+    ipv6 = NULL;
+    ip1 = g_strdup (data[1]);
+    ip2 = (c == 3) ? g_strdup (data[2]) : NULL;
+    g_strfreev (data);
+    g_string_free (s, TRUE);
+
+    mm_bearer_ip_config_set_method (out_ip4_config, MM_BEARER_IP_METHOD_UNKNOWN);
+    mm_bearer_ip_config_set_method (out_ip6_config, MM_BEARER_IP_METHOD_UNKNOWN);
+
+    data1 = g_strsplit (ip1, ".", -1);
+    c = g_strv_length (data1);
+    if (c == 4) {
+        ipv4 = g_strdup (ip1);
+    } else if (c == 8) {
+        /* addr+mask concatenated - see first_four_octets(). */
+        ipv4 = first_four_octets (data1, c);
+    }
+    if (ipv4) {
+        mm_bearer_ip_config_set_method (out_ip4_config, MM_BEARER_IP_METHOD_STATIC);
+        mm_bearer_ip_config_set_address (out_ip4_config, ipv4);
+        mm_bearer_ip_config_set_prefix (out_ip4_config, 24);
+        /* Real gateway comes from AT+CGCONTRDP (see ip_config_dns_gw_ready),
+         * NOT from here - setting gateway == our own address made netifd
+         * try "ip route add default via <our-own-ip>", which the kernel
+         * rejects, and that silent route-setup failure is very likely why
+         * the connection got torn down again right after MM reported it
+         * as fully connected. */
+        g_free (ipv4);
+        ipv4 = NULL;
+    }
+    if (c == 16)
+        mm_bearer_ip_config_set_method (out_ip6_config, MM_BEARER_IP_METHOD_DHCP);
+    g_strfreev (data1);
+
+    if (ip2) {
+        data2 = g_strsplit (ip2, ".", -1);
+        c = g_strv_length (data2);
+        if (c == 4) {
+            ipv4 = g_strdup (ip2);
+        } else if (c == 8) {
+            ipv4 = first_four_octets (data2, c);
+        }
+        if (ipv4) {
+            mm_bearer_ip_config_set_method (out_ip4_config, MM_BEARER_IP_METHOD_STATIC);
+            mm_bearer_ip_config_set_address (out_ip4_config, ipv4);
+            mm_bearer_ip_config_set_prefix (out_ip4_config, 24);
+            g_free (ipv4);
+            ipv4 = NULL;
+        }
+        if (c == 16) {
+            ipv6 = ip2;
+            mm_bearer_ip_config_set_method (out_ip6_config, MM_BEARER_IP_METHOD_DHCP);
+            gstmp = g_string_new ("");
+            deztohexip (ipv6, gstmp);
+            ipv6 = gstmp->str;
+        }
+        g_strfreev (data2);
+    }
+
+    mm_obj_info (NULL, "ipv4: %s", mm_bearer_ip_config_get_address (out_ip4_config));
+    mm_obj_info (NULL, "ipv6: %s", ipv6 ? ipv6 : "(none)");
+
+    g_free (ip1);
+    g_free (ip2);
+
+    return TRUE;
+}
+
+typedef struct {
+    MMBaseModem *modem;
+    MMPortSerialAt *primary;
+    guint cid;
+    MMBearerIpConfig *ipv4_config;
+    MMBearerIpConfig *ipv6_config;
+} GetIpConfig3gppContext;
+
+static void
+get_ip_config_context_free (GetIpConfig3gppContext *ctx)
+{
+    g_object_unref (ctx->primary);
+    g_object_unref (ctx->modem);
+    g_clear_object (&ctx->ipv4_config);
+    g_clear_object (&ctx->ipv6_config);
+    g_slice_free (GetIpConfig3gppContext, ctx);
+}
+
+static gboolean
+get_ip_config_3gpp_finish (MMBroadbandBearer *self,
+                            GAsyncResult *res,
+                            MMBearerIpConfig **ipv4_config,
+                            MMBearerIpConfig **ipv6_config,
+                            GError **error)
+{
+    MMBearerConnectResult *configs;
+    MMBearerIpConfig *ipv4, *ipv6;
+
+    configs = g_task_propagate_pointer (G_TASK (res), error);
+    if (!configs)
+        return FALSE;
+
+    ipv4 = mm_bearer_connect_result_peek_ipv4_config (configs);
+    ipv6 = mm_bearer_connect_result_peek_ipv6_config (configs);
+    g_assert (ipv4 || ipv6);
+    if (ipv4_config && ipv4)
+        *ipv4_config = g_object_ref (ipv4);
+    if (ipv6_config && ipv6)
+        *ipv6_config = g_object_ref (ipv6);
+
+    mm_bearer_connect_result_unref (configs);
+    return TRUE;
+}
+
+static void
+ip_config_dns_gw_ready (MMBaseModem *modem, GAsyncResult *res, GTask *task)
+{
+    GetIpConfig3gppContext *ctx;
+    const gchar *response;
+    GError *error = NULL;
+    MMBearerConnectResult *connect_result;
+    gchar *gw, *dns1, *dns2, *dnsv61, *dnsv62;
+    const gchar *dns[3] = { 0 };
+    const gchar *dnsv6[3] = { 0 };
+    GString *s;
+    gchar **data;
+    int c;
+    GString *gstmp;
+
+    ctx = g_task_get_task_data (task);
+    response = mm_base_modem_at_command_full_finish (modem, res, &error);
+
+    if (!response || !g_str_has_prefix (response, "+CGCONTRDP")) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED, "Missing +CGCONTRDP prefix");
+        g_clear_error (&error);
+        return;
+    }
+
+    response = mm_strip_tag (response, "+CGCONTRDP: ");
+    s = g_string_new (response);
+    g_string_replace (s, "\"", "", -1);
+
+    data = g_strsplit (s->str, ",", -1);
+    c = g_strv_length (data);
+
+    /* AT+CGCONTRDP has a minimum of 7 fields (cid, bearer_id, apn,
+     * local_addr+mask, gw_addr, dns_prim, dns_sec) per 3GPP TS 27.007;
+     * everything past that (P-CSCF, IPv6 DNS at indices 28/29, MTU,
+     * etc) is optional and modem/PDP-type dependent. Previously this
+     * demanded 30 fields unconditionally and would reject every plain
+     * IPv4 response, and unconditionally read data[28]/data[29] for
+     * IPv6 DNS even when they didn't exist. */
+    if (c < 7) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                  "Couldn't match +CGCONTRDP reply (got %d fields, need at least 7)", c);
+        g_strfreev (data);
+        g_string_free (s, TRUE);
+        return;
+    }
+
+    gw = g_strdup (data[4]);
+    dns1 = g_strdup (data[5]);
+    dns2 = g_strdup (data[6]);
+    dnsv61 = (c > 28 && data[28] && *data[28]) ? g_strdup (data[28]) : NULL;
+    dnsv62 = (c > 29 && data[29] && *data[29]) ? g_strdup (data[29]) : NULL;
+    g_strfreev (data);
+    g_string_free (s, TRUE);
+
+    if (gw && *gw)
+        mm_bearer_ip_config_set_gateway (ctx->ipv4_config, gw);
+    g_free (gw);
+
+    if (dnsv61) {
+        gstmp = g_string_new ("");
+        deztohexip (dnsv61, gstmp);
+        g_free (dnsv61);
+        dnsv61 = g_string_free (gstmp, FALSE);
+    }
+
+    if (dnsv62) {
+        gstmp = g_string_new ("");
+        deztohexip (dnsv62, gstmp);
+        g_free (dnsv62);
+        dnsv62 = g_string_free (gstmp, FALSE);
+    }
+
+    dns[0] = dns1;
+    dns[1] = dns2;
+    dnsv6[0] = dnsv61;
+    dnsv6[1] = dnsv62;
+
+    mm_bearer_ip_config_set_dns (ctx->ipv4_config, dns);
+    if (dnsv61 || dnsv62)
+        mm_bearer_ip_config_set_dns (ctx->ipv6_config, dnsv6);
+
+    connect_result = mm_bearer_connect_result_new (mm_base_modem_peek_best_data_port (modem, MM_PORT_TYPE_NET),
+                                                     ctx->ipv4_config, ctx->ipv6_config);
+
+    g_free (dns1);
+    g_free (dns2);
+    g_free (dnsv61);
+    g_free (dnsv62);
+
+    g_task_return_pointer (task, connect_result, (GDestroyNotify) mm_bearer_connect_result_unref);
+    g_object_unref (task);
+}
+
+static void
+ip_config_ipaddress_ready (MMBaseModem *modem,
+                            GAsyncResult *res,
+                            GTask *task)
+{
+    gchar *command;
+    const gchar *response;
+    GError *error = NULL;
+    GetIpConfig3gppContext *ctx;
+
+    ctx = g_task_get_task_data (task);
+    ctx->ipv4_config = mm_bearer_ip_config_new ();
+    ctx->ipv6_config = mm_bearer_ip_config_new ();
+
+    response = mm_base_modem_at_command_full_finish (modem, res, &error);
+    if (!response) {
+        mm_obj_dbg (NULL, "AT+CGPADDR failed, no IP data: %s", error->message);
+        g_task_return_error (task, error);
+        return;
+    }
+
+    if (!parse_ip (response, ctx->ipv4_config, ctx->ipv6_config, &error)) {
+        g_task_return_error (task, error);
+        return;
+    }
+
+    command = g_strdup_printf ("AT+CGCONTRDP=%d", ctx->cid);
+    mm_base_modem_at_command_full (MM_BASE_MODEM (modem),
+                                    MM_IFACE_PORT_AT (ctx->primary),
+                                    command,
+                                    3,
+                                    FALSE,
+                                    FALSE, /* raw */
+                                    NULL, /* cancellable */
+                                    (GAsyncReadyCallback) ip_config_dns_gw_ready,
+                                    task);
+    g_free (command);
+}
+
+static void
+get_ip_config_3gpp (MMBroadbandBearer *self,
+                     MMBroadbandModem *modem,
+                     MMPortSerialAt *primary,
+                     MMPortSerialAt *secondary,
+                     MMPort *data,
+                     guint cid,
+                     MMBearerIpFamily ip_family,
+                     GAsyncReadyCallback callback,
+                     gpointer user_data)
+{
+    GetIpConfig3gppContext *ctx;
+    GTask *task;
+    gchar *command;
+
+    mm_obj_info (NULL, "xmmusb data port: %s", mm_port_get_device (data));
+
+    ctx = g_slice_new0 (GetIpConfig3gppContext);
+    ctx->modem = MM_BASE_MODEM (g_object_ref (modem));
+    ctx->primary = g_object_ref (primary);
+    ctx->cid = cid;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    g_task_set_task_data (task, ctx, (GDestroyNotify) get_ip_config_context_free);
+
+    command = g_strdup_printf ("AT+CGPADDR=%d", cid);
+    mm_base_modem_at_command_full (MM_BASE_MODEM (modem),
+                                    MM_IFACE_PORT_AT (primary),
+                                    command,
+                                    3,
+                                    FALSE,
+                                    FALSE, /* raw */
+                                    NULL, /* cancellable */
+                                    (GAsyncReadyCallback) ip_config_ipaddress_ready,
+                                    task);
+    g_free (command);
+}
+
+/*****************************************************************************/
+
+static void
+mm_broadband_bearer_xmmusb_init (MMBroadbandBearerXmmUsb *self)
+{
+    self->priv = G_TYPE_INSTANCE_GET_PRIVATE (self,
+                                               MM_TYPE_BROADBAND_BEARER_XMMUSB,
+                                               MMBroadbandBearerXmmUsbPrivate);
+}
+
+static void
+mm_broadband_bearer_xmmusb_class_init (MMBroadbandBearerXmmUsbClass *klass)
+{
+    MMBroadbandBearerClass *broadband_bearer_class = MM_BROADBAND_BEARER_CLASS (klass);
+
+    broadband_bearer_class->dial_3gpp = dial_3gpp;
+    broadband_bearer_class->dial_3gpp_finish = dial_3gpp_finish;
+    broadband_bearer_class->get_ip_config_3gpp = get_ip_config_3gpp;
+    broadband_bearer_class->get_ip_config_3gpp_finish = get_ip_config_3gpp_finish;
+    broadband_bearer_class->disconnect_3gpp = disconnect_3gpp;
+}
