+/*****************************************************************************/
+/* Bearer creation */
+
+static MMBaseBearer *
+modem_create_bearer_finish (MMIfaceModem *self,
+                             GAsyncResult *res,
+                             GError **error)
+{
+    return g_task_propagate_pointer (G_TASK (res), error);
+}
+
+static void
+broadband_bearer_xmmusb_new_ready (GObject *source,
+                                    GAsyncResult *res,
+                                    GTask *task)
+{
+    MMBaseBearer *bearer = NULL;
+    GError *error = NULL;
+
+    bearer = mm_broadband_bearer_xmmusb_new_finish (res, &error);
+    if (!bearer)
+        g_task_return_error (task, error);
+    else
+        g_task_return_pointer (task, bearer, g_object_unref);
+
+    g_object_unref (task);
+}
+
+static void
+modem_create_bearer (MMIfaceModem *self,
+                      MMBearerProperties *props,
+                      GAsyncReadyCallback callback,
+                      gpointer user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+
+    mm_broadband_bearer_xmmusb_new (MM_BROADBAND_MODEM (self),
+                                     props,
+                                     NULL,
+                                     (GAsyncReadyCallback) broadband_bearer_xmmusb_new_ready,
+                                     task);
+}
+
+/*****************************************************************************/
+/* Supported capabilities - GSM_UMTS is a single MM flag covering 2G+3G
+ * together, there's no way to say "3G but not 2G" at this level. The
+ * L850-GL/L860-GL manual confirms UMTS support alongside LTE. Actual
+ * 2G exclusion happens at the MODES level below, where mm_xmm_parse_
+ * xact_test_response() filters supported modes against the bands the
+ * modem actually supports - XACT is known to lie about 2G support on
+ * 3G+4G-only hardware, which is exactly this module. */
+
+static GArray *
+load_supported_capabilities_finish (MMIfaceModem *self,
+                                     GAsyncResult *res,
+                                     GError **error)
+{
+    return g_task_propagate_pointer (G_TASK (res), error);
+}
+
+static void
+load_supported_capabilities (MMIfaceModem *self,
+                              GAsyncReadyCallback callback,
+                              gpointer user_data)
+{
+    GTask *task;
+    GArray *capabilities;
+    MMModemCapability cap = (MM_MODEM_CAPABILITY_GSM_UMTS | MM_MODEM_CAPABILITY_LTE);
+
+    task = g_task_new (self, NULL, callback, user_data);
+    capabilities = g_array_new (FALSE, FALSE, sizeof (MMModemCapability));
+    g_array_append_val (capabilities, cap);
+    g_task_return_pointer (task, capabilities, (GDestroyNotify) g_array_unref);
+    g_object_unref (task);
+}
+
+/*****************************************************************************/
+/* Supported modes/bands - AT+XACT=?, parsed with the real upstream
+ * mm_xmm_parse_xact_test_response(). Queried once and cached, same
+ * pattern as mm-shared-xmm.c. */
+
+static GArray *
+load_supported_modes_finish (MMIfaceModem *self,
+                              GAsyncResult *res,
+                              GError **error)
+{
+    if (!g_task_propagate_boolean (G_TASK (res), error))
+        return NULL;
+    g_assert (MM_BROADBAND_MODEM_XMMUSB (self)->priv->supported_modes);
+    return g_array_ref (MM_BROADBAND_MODEM_XMMUSB (self)->priv->supported_modes);
+}
+
+static GArray *
+load_supported_bands_finish (MMIfaceModem *self,
+                              GAsyncResult *res,
+                              GError **error)
+{
+    if (!g_task_propagate_boolean (G_TASK (res), error))
+        return NULL;
+    g_assert (MM_BROADBAND_MODEM_XMMUSB (self)->priv->supported_bands);
+    return g_array_ref (MM_BROADBAND_MODEM_XMMUSB (self)->priv->supported_bands);
+}
+
+static void
+xact_test_ready (MMBaseModem *self,
+                  GAsyncResult *res,
+                  GTask *task)
+{
+    const gchar *response;
+    GError *error = NULL;
+    MMBroadbandModemXmmUsbPrivate *priv;
+
+    priv = MM_BROADBAND_MODEM_XMMUSB (self)->priv;
+
+    response = mm_base_modem_at_command_finish (self, res, &error);
+    if (!response ||
+        !mm_xmm_parse_xact_test_response (response,
+                                           self,
+                                           &priv->supported_modes,
+                                           &priv->supported_bands,
+                                           &error))
+        g_task_return_error (task, error);
+    else
+        g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+common_load_supported_modes_bands (GTask *task)
+{
+    mm_base_modem_at_command (MM_BASE_MODEM (g_task_get_source_object (task)),
+                               "+XACT=?",
+                               3,
+                               TRUE,
+                               (GAsyncReadyCallback) xact_test_ready,
+                               task);
+}
+
+static void
+load_supported_modes (MMIfaceModem *self,
+                       GAsyncReadyCallback callback,
+                       gpointer user_data)
+{
+    GTask *task;
+    MMBroadbandModemXmmUsbPrivate *priv;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    priv = MM_BROADBAND_MODEM_XMMUSB (self)->priv;
+
+    if (!priv->supported_modes) {
+        common_load_supported_modes_bands (task);
+        return;
+    }
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+load_supported_bands (MMIfaceModem *self,
+                       GAsyncReadyCallback callback,
+                       gpointer user_data)
+{
+    GTask *task;
+    MMBroadbandModemXmmUsbPrivate *priv;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    priv = MM_BROADBAND_MODEM_XMMUSB (self)->priv;
+
+    if (!priv->supported_bands) {
+        common_load_supported_modes_bands (task);
+        return;
+    }
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+/*****************************************************************************/
+/* Current modes/bands - AT+XACT?, parsed with the real upstream
+ * mm_xmm_parse_xact_query_response(). Confirmed against real hardware
+ * output:
+ *   +XACT: 4,2,1,1,2,4,5,8,101,102,103,104,105,107,108,112,113,114,
+ *          117,118,119,120,125,126,128,129,130,134,138,139,140,141,
+ *          142,143,146,148,166
+ * field[0]=4 -> allowed = 3G+4G (index 4 in xmm_modes), field[1]=2 ->
+ * preferred = 4G, field[2]=1 -> ignored, rest = band list (raw 3G,
+ * +100 for LTE) - exactly what mm_xmm_parse_xact_query_response()
+ * expects. */
+
+static gboolean
+load_current_modes_finish (MMIfaceModem *self,
+                            GAsyncResult *res,
+                            MMModemMode *allowed,
+                            MMModemMode *preferred,
+                            GError **error)
+{
+    MMModemModeCombination *result;
+
+    result = g_task_propagate_pointer (G_TASK (res), error);
+    if (!result)
+        return FALSE;
+    *allowed = result->allowed;
+    *preferred = result->preferred;
+    g_free (result);
+    return TRUE;
+}
+
+static void
+xact_query_modes_ready (MMBaseModem *self,
+                         GAsyncResult *res,
+                         GTask *task)
+{
+    const gchar *response;
+    GError *error = NULL;
+    MMBroadbandModemXmmUsbPrivate *priv;
+    MMModemModeCombination *result;
+
+    priv = MM_BROADBAND_MODEM_XMMUSB (self)->priv;
+    result = g_new0 (MMModemModeCombination, 1);
+
+    response = mm_base_modem_at_command_finish (self, res, &error);
+    if (!response || !mm_xmm_parse_xact_query_response (response, result, NULL, &error)) {
+        priv->allowed_modes = MM_MODEM_MODE_NONE;
+        g_free (result);
+        g_task_return_error (task, error);
+    } else {
+        priv->allowed_modes = result->allowed;
+        g_task_return_pointer (task, result, g_free);
+    }
+    g_object_unref (task);
+}
+
+static void
+load_current_modes (MMIfaceModem *self,
+                     GAsyncReadyCallback callback,
+                     gpointer user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    mm_base_modem_at_command (MM_BASE_MODEM (self),
+                               "+XACT?",
+                               3,
+                               FALSE,
+                               (GAsyncReadyCallback) xact_query_modes_ready,
+                               task);
+}
+
+static GArray *
+load_current_bands_finish (MMIfaceModem *self,
+                            GAsyncResult *res,
+                            GError **error)
+{
+    return (GArray *) g_task_propagate_pointer (G_TASK (res), error);
+}
+
+static void
+xact_query_bands_ready (MMBaseModem *self,
+                         GAsyncResult *res,
+                         GTask *task)
+{
+    const gchar *response;
+    GError *error = NULL;
+    GArray *result = NULL;
+
+    response = mm_base_modem_at_command_finish (self, res, &error);
+    if (!response || !mm_xmm_parse_xact_query_response (response, NULL, &result, &error))
+        g_task_return_error (task, error);
+    else
+        g_task_return_pointer (task, result, (GDestroyNotify) g_array_unref);
+    g_object_unref (task);
+}
+
+static void
+load_current_bands (MMIfaceModem *self,
+                     GAsyncReadyCallback callback,
+                     gpointer user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    mm_base_modem_at_command (MM_BASE_MODEM (self),
+                               "+XACT?",
+                               3,
+                               FALSE,
+                               (GAsyncReadyCallback) xact_query_bands_ready,
+                               task);
+}
+
+/*****************************************************************************/
+/* Set current modes - AT+XACT=<mode>[,<preferred>], built with the
+ * real upstream mm_xmm_build_xact_set_command(). Passing NULL for
+ * bands keeps whatever band lock is already set. */
+
+static gboolean
+set_current_modes_finish (MMIfaceModem *self,
+                           GAsyncResult *res,
+                           GError **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+xact_set_modes_ready (MMBaseModem *self,
+                       GAsyncResult *res,
+                       GTask *task)
+{
+    GError *error = NULL;
+
+    if (!mm_base_modem_at_command_finish (self, res, &error))
+        g_task_return_error (task, error);
+    else
+        g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+set_current_modes (MMIfaceModem *self,
+                    MMModemMode allowed,
+                    MMModemMode preferred,
+                    GAsyncReadyCallback callback,
+                    gpointer user_data)
+{
+    GTask *task;
+    MMModemModeCombination mode;
+    gchar *command;
+    GError *error = NULL;
+
+    task = g_task_new (self, NULL, callback, user_data);
+
+    if (allowed != MM_MODEM_MODE_ANY) {
+        mode.allowed = allowed;
+        mode.preferred = preferred;
+    } else {
+        MMBroadbandModemXmmUsbPrivate *priv = MM_BROADBAND_MODEM_XMMUSB (self)->priv;
+
+        mode.allowed = mm_xmm_get_modem_mode_any (priv->supported_modes);
+        mode.preferred = MM_MODEM_MODE_NONE;
+    }
+
+    command = mm_xmm_build_xact_set_command (&mode, NULL, &error);
+    if (!command) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    mm_base_modem_at_command (MM_BASE_MODEM (self),
+                               command,
+                               10,
+                               FALSE,
+                               (GAsyncReadyCallback) xact_set_modes_ready,
+                               task);
+    g_free (command);
+}
+
+/*****************************************************************************/
+/* Set current bands - validated against the currently allowed modes
+ * (a 3G band can't be set while only 4G is allowed, etc), same rules
+ * upstream enforces, then built with mm_xmm_build_xact_set_command(). */
+
+static gboolean
+set_current_bands_finish (MMIfaceModem *self,
+                           GAsyncResult *res,
+                           GError **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+xact_set_bands_ready (MMBaseModem *self,
+                       GAsyncResult *res,
+                       GTask *task)
+{
+    GError *error = NULL;
+
+    if (!mm_base_modem_at_command_finish (self, res, &error))
+        g_task_return_error (task, error);
+    else
+        g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static gchar *
+validate_and_build_command_set_current_bands (MMBroadbandModemXmmUsb *self,
+                                               const GArray *bands_array,
+                                               const GArray *supported_modes,
+                                               MMModemMode allowed_modes,
+                                               GError **error)
+{
+    gboolean band_3g_found = FALSE;
+    gboolean band_4g_found = FALSE;
+    GArray *unapplied_bands;
+    GError *inner_error = NULL;
+    guint i;
+
+    if (bands_array->len == 1 && g_array_index (bands_array, MMModemBand, 0) == MM_MODEM_BAND_ANY) {
+        MMModemModeCombination mode;
+
+        mode.allowed = allowed_modes;
+        mode.preferred = MM_MODEM_MODE_NONE;
+        return mm_xmm_build_xact_set_command (&mode, bands_array, error);
+    }
+
+    unapplied_bands = g_array_new (FALSE, FALSE, sizeof (MMModemBand));
+    for (i = 0; i < bands_array->len; i++) {
+        MMModemBand band = g_array_index (bands_array, MMModemBand, i);
+
+        if (mm_common_band_is_eutran (band)) {
+            band_4g_found = TRUE;
+            if (!(allowed_modes & MM_MODEM_MODE_4G))
+                g_array_append_val (unapplied_bands, band);
+        }
+        if (mm_common_band_is_utran (band)) {
+            band_3g_found = TRUE;
+            if (!(allowed_modes & MM_MODEM_MODE_3G))
+                g_array_append_val (unapplied_bands, band);
+        }
+    }
+
+    if ((allowed_modes & MM_MODEM_MODE_3G) && !band_3g_found) {
+        inner_error = g_error_new (MM_CORE_ERROR, MM_CORE_ERROR_INVALID_ARGS,
+                                    "At least one UTRAN band is required when 3G mode is allowed");
+        goto out;
+    }
+    if ((allowed_modes & MM_MODEM_MODE_4G) && !band_4g_found) {
+        inner_error = g_error_new (MM_CORE_ERROR, MM_CORE_ERROR_INVALID_ARGS,
+                                    "At least one E-UTRAN band is required when 4G mode is allowed");
+        goto out;
+    }
+    if (unapplied_bands->len > 0) {
+        gchar *str = mm_common_build_bands_string ((const MMModemBand *) (gconstpointer) unapplied_bands->data,
+                                                     unapplied_bands->len);
+        inner_error = g_error_new (MM_CORE_ERROR, MM_CORE_ERROR_INVALID_ARGS,
+                                    "Cannot update bands for modes not currently allowed: %s", str);
+        g_free (str);
+        goto out;
+    }
+
+out:
+    g_array_unref (unapplied_bands);
+    if (inner_error) {
+        g_propagate_error (error, inner_error);
+        return NULL;
+    }
+    return mm_xmm_build_xact_set_command (NULL, bands_array, error);
+}
+
+static void
+set_current_bands (MMIfaceModem *self,
+                    GArray *bands_array,
+                    GAsyncReadyCallback callback,
+                    gpointer user_data)
+{
+    GTask *task;
+    gchar *command = NULL;
+    GError *error = NULL;
+    MMBroadbandModemXmmUsbPrivate *priv;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    priv = MM_BROADBAND_MODEM_XMMUSB (self)->priv;
+
+    if (priv->allowed_modes == MM_MODEM_MODE_NONE) {
+        error = g_error_new (MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                              "Cannot set bands if allowed modes are unknown");
+    } else {
+        command = validate_and_build_command_set_current_bands (MM_BROADBAND_MODEM_XMMUSB (self),
+                                                                  bands_array,
+                                                                  priv->supported_modes,
+                                                                  priv->allowed_modes,
+                                                                  &error);
+    }
+
+    if (!command) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    mm_base_modem_at_command (MM_BASE_MODEM (self),
+                               command,
+                               10,
+                               FALSE,
+                               (GAsyncReadyCallback) xact_set_bands_ready,
+                               task);
+    g_free (command);
+}
+
+/*****************************************************************************/
+/* Power state - AT+CFUN
+ *
+ * MMBroadbandModem's generic implementation only provides a default
+ * modem_power_up (AT+CFUN=1, fire-and-forget); it does NOT provide
+ * modem_power_down. Without an explicit override here, any MM flow
+ * that needs to power the modem down first - most notably updating
+ * the initial EPS bearer settings when the configured APN differs
+ * from what's already active - fails immediately with "Requested
+ * power transition is not supported by this modem", without ever
+ * sending an AT command. The L860 AT command manual confirms
+ * AT+CFUN=4 (flight mode) is supported, so implement it explicitly. */
+
+static MMModemPowerState
+load_power_state_finish (MMIfaceModem *self,
+                          GAsyncResult *res,
+                          GError **error)
+{
+    GError *inner_error = NULL;
+    gssize value;
+
+    value = g_task_propagate_int (G_TASK (res), &inner_error);
+    if (inner_error) {
+        g_propagate_error (error, inner_error);
+        return MM_MODEM_POWER_STATE_UNKNOWN;
+    }
+    return (MMModemPowerState) value;
+}
+
+static void
+load_power_state_ready (MMBaseModem *self,
+                         GAsyncResult *res,
+                         GTask *task)
+{
+    const gchar *response;
+    GError *error = NULL;
+    guint fun;
+    MMModemPowerState state;
+
+    response = mm_base_modem_at_command_finish (self, res, &error);
+    if (!response) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    if (!mm_3gpp_parse_cfun_query_response (response, &fun, &error)) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    switch (fun) {
+        case 1:
+            state = MM_MODEM_POWER_STATE_ON;
+            break;
+        case 4:
+            state = MM_MODEM_POWER_STATE_LOW;
+            break;
+        case 0:
+            state = MM_MODEM_POWER_STATE_OFF;
+            break;
+        default:
+            state = MM_MODEM_POWER_STATE_UNKNOWN;
+            break;
+    }
+
+    g_task_return_int (task, (gssize) state);
+    g_object_unref (task);
+}
+
+static void
+load_power_state (MMIfaceModem *self,
+                   GAsyncReadyCallback callback,
+                   gpointer user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    mm_base_modem_at_command (MM_BASE_MODEM (self),
+                               "+CFUN?",
+                               3,
+                               FALSE,
+                               (GAsyncReadyCallback) load_power_state_ready,
+                               task);
+}
+
+static gboolean
+modem_power_down_finish (MMIfaceModem *self,
+                          GAsyncResult *res,
+                          GError **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
+static void
+modem_power_down_ready (MMBaseModem *self,
+                         GAsyncResult *res,
+                         GTask *task)
+{
+    GError *error = NULL;
+
+    if (!mm_base_modem_at_command_finish (self, res, &error)) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+modem_power_down (MMIfaceModem *self,
+                   GAsyncReadyCallback callback,
+                   gpointer user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    mm_base_modem_at_command (MM_BASE_MODEM (self),
+                               "+CFUN=4",
+                               5,
+                               FALSE,
+                               (GAsyncReadyCallback) modem_power_down_ready,
+                               task);
+}
+
+/*****************************************************************************/
+/* 3GPP profile manager - check_format override
+ *
+ * The generic MMBroadbandModem implementation queries AT+CGDCONT=?
+ * and uses whatever cid range it reports verbatim. On this L860-GL
+ * that range includes cid 0, but AT+CGACT=1,0 fails with CME error
+ * 500 on real hardware - cid 0 is reported as valid but isn't usable.
+ * Reuse the exact same AT+CGDCONT=? query/parse the generic code does
+ * (mm_3gpp_parse_cgdcont_test_response +
+ * mm_3gpp_pdp_context_format_list_find_range are both public core
+ * helpers), just clamp the minimum to 1 afterwards. Without this,
+ * MM ends up picking cid=0 for the bearer's dial_3gpp/CGACT, which is
+ * exactly the "Unknown mobile equipment error: 500" seen on connect. */
+
+typedef struct {
+    MMBearerIpFamily ip_type;
+    gint             min_profile_id;
+    gint             max_profile_id;
+} CheckFormatContext;
+
+static void
+check_format_context_free (CheckFormatContext *ctx)
+{
+    g_slice_free (CheckFormatContext, ctx);
+}
+
+static gboolean
+modem_3gpp_profile_manager_check_format_finish (MMIfaceModem3gppProfileManager *self,
+                                                 GAsyncResult *res,
+                                                 gboolean *new_id,
+                                                 gint *min_profile_id,
+                                                 gint *max_profile_id,
+                                                 GEqualFunc *apn_cmp,
+                                                 MM3gppProfileCmpFlags *profile_cmp_flags,
+                                                 GError **error)
+{
+    CheckFormatContext *ctx;
+
+    if (!g_task_propagate_boolean (G_TASK (res), error))
+        return FALSE;
+
+    ctx = g_task_get_task_data (G_TASK (res));
+    if (new_id)
+        *new_id = TRUE;
+    if (min_profile_id)
+        *min_profile_id = ctx->min_profile_id;
+    if (max_profile_id)
+        *max_profile_id = ctx->max_profile_id;
+    if (apn_cmp)
+        *apn_cmp = (GEqualFunc) mm_3gpp_cmp_apn_name;
+    if (profile_cmp_flags)
+        *profile_cmp_flags = (MM_3GPP_PROFILE_CMP_FLAGS_NO_AUTH |
+                              MM_3GPP_PROFILE_CMP_FLAGS_NO_APN_TYPE |
+                              MM_3GPP_PROFILE_CMP_FLAGS_NO_ACCESS_TYPE_PREFERENCE |
+                              MM_3GPP_PROFILE_CMP_FLAGS_NO_ROAMING_ALLOWANCE |
+                              MM_3GPP_PROFILE_CMP_FLAGS_NO_PROFILE_SOURCE);
+    return TRUE;
+}
+
+static void
+check_format_cgdcont_test_ready (MMBaseModem *self,
+                                  GAsyncResult *res,
+                                  GTask *task)
+{
+    CheckFormatContext *ctx;
+    const gchar *response;
+    GList *format_list = NULL;
+    GError *error = NULL;
+
+    ctx = g_task_get_task_data (task);
+
+    response = mm_base_modem_at_command_finish (self, res, &error);
+    if (!response) {
+        g_error_free (error);
+    } else {
+        format_list = mm_3gpp_parse_cgdcont_test_response (response, self, &error);
+        if (error) {
+            g_error_free (error);
+        } else if (!mm_3gpp_pdp_context_format_list_find_range (format_list, ctx->ip_type,
+                                                                 &ctx->min_profile_id, &ctx->max_profile_id)) {
+            ctx->min_profile_id = 1;
+            ctx->max_profile_id = G_MAXINT - 1;
+        }
+    }
+
+    if (format_list)
+        mm_3gpp_pdp_context_format_list_free (format_list);
+
+    /* Clamp: cid 0 is reported as valid by AT+CGDCONT=? on this modem
+     * but AT+CGACT=1,0 fails with CME error 500 on real hardware. */
+    if (ctx->min_profile_id < 1)
+        ctx->min_profile_id = 1;
+    if (ctx->max_profile_id < ctx->min_profile_id)
+        ctx->max_profile_id = G_MAXINT - 1;
+
+    g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+static void
+modem_3gpp_profile_manager_check_format (MMIfaceModem3gppProfileManager *self,
+                                          MMBearerIpFamily ip_type,
+                                          GAsyncReadyCallback callback,
+                                          gpointer user_data)
+{
+    GTask *task;
+    CheckFormatContext *ctx;
+
+    task = g_task_new (self, NULL, callback, user_data);
+    ctx = g_slice_new0 (CheckFormatContext);
+    ctx->ip_type = ip_type;
+    ctx->min_profile_id = 1;
+    ctx->max_profile_id = G_MAXINT - 1;
+    g_task_set_task_data (task, ctx, (GDestroyNotify) check_format_context_free);
+
+    mm_base_modem_at_command (MM_BASE_MODEM (self),
+                               "+CGDCONT=?",
+                               3,
+                               TRUE,
+                               (GAsyncReadyCallback) check_format_cgdcont_test_ready,
+                               task);
+}
+
+static void
+iface_modem_3gpp_profile_manager_init (MMIfaceModem3gppProfileManagerInterface *iface)
+{
+    iface->check_format = modem_3gpp_profile_manager_check_format;
+    iface->check_format_finish = modem_3gpp_profile_manager_check_format_finish;
+}
+
+/*****************************************************************************/
+
+static void
+iface_modem_init (MMIfaceModemInterface *iface)
+{
+    iface->create_bearer = modem_create_bearer;
+    iface->create_bearer_finish = modem_create_bearer_finish;
+    iface->load_supported_capabilities = load_supported_capabilities;
+    iface->load_supported_capabilities_finish = load_supported_capabilities_finish;
+    iface->load_supported_modes = load_supported_modes;
+    iface->load_supported_modes_finish = load_supported_modes_finish;
+    iface->load_supported_bands = load_supported_bands;
+    iface->load_supported_bands_finish = load_supported_bands_finish;
+    iface->load_current_modes = load_current_modes;
+    iface->load_current_modes_finish = load_current_modes_finish;
+    iface->load_current_bands = load_current_bands;
+    iface->load_current_bands_finish = load_current_bands_finish;
+    iface->set_current_modes = set_current_modes;
+    iface->set_current_modes_finish = set_current_modes_finish;
+    iface->set_current_bands = set_current_bands;
+    iface->set_current_bands_finish = set_current_bands_finish;
+    iface->load_power_state = load_power_state;
+    iface->load_power_state_finish = load_power_state_finish;
+    iface->modem_power_down = modem_power_down;
+    iface->modem_power_down_finish = modem_power_down_finish;
+}
+
+static void
+mm_broadband_modem_xmmusb_init (MMBroadbandModemXmmUsb *self)
+{
+    self->priv = G_TYPE_INSTANCE_GET_PRIVATE (self,
+                                               MM_TYPE_BROADBAND_MODEM_XMMUSB,
+                                               MMBroadbandModemXmmUsbPrivate);
+}
+
+static void
+finalize (GObject *object)
+{
+    MMBroadbandModemXmmUsbPrivate *priv = MM_BROADBAND_MODEM_XMMUSB (object)->priv;
+
+    if (priv->supported_modes)
+        g_array_unref (priv->supported_modes);
+    if (priv->supported_bands)
+        g_array_unref (priv->supported_bands);
+
+    G_OBJECT_CLASS (mm_broadband_modem_xmmusb_parent_class)->finalize (object);
+}
+
+static void
+mm_broadband_modem_xmmusb_class_init (MMBroadbandModemXmmUsbClass *klass)
+{
+    GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+    g_type_class_add_private (klass, sizeof (MMBroadbandModemXmmUsbPrivate));
+    object_class->finalize = finalize;
+}
