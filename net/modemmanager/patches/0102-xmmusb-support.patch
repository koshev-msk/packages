diff --git a/src/plugins/xmmusb/mm-plugin-xmmusb.c b/src/plugins/xmmusb/mm-plugin-xmmusb.c
new file mode 100644
index 0000000..49c72c7
--- /dev/null
+++ b/src/plugins/xmmusb/mm-plugin-xmmusb.c
@@ -0,0 +1,69 @@
+/* -*- Mode: C; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- */
+#include <string.h>
+#include <gmodule.h>
+
+#define _LIBMM_INSIDE_MM
+#include <libmm-glib.h>
+
+#include "mm-plugin-common.h"
+#include "mm-broadband-modem.h"
+#include "mm-log-object.h"
+
+#include "mm-broadband-modem-xmmusb.h"
+
+#define MM_TYPE_PLUGIN_XMMUSB mm_plugin_xmmusb_get_type ()
+MM_DEFINE_PLUGIN (XMMUSB, xmmusb, XmmUsb)
+
+static MMBaseModem *
+create_modem (MMPlugin *self,
+              const gchar *uid,
+              const gchar *physdev,
+              const gchar **drivers,
+              guint16 vendor,
+              guint16 product,
+              guint16 subsystem_vendor,
+              guint16 subsystem_device,
+              GList *probes,
+              GError **error)
+{
+    return MM_BASE_MODEM (mm_broadband_modem_xmmusb_new (uid,
+                                                           physdev,
+                                                           drivers,
+                                                           mm_plugin_get_name (self),
+                                                           vendor,
+                                                           product));
+}
+
+MM_PLUGIN_NAMED_CREATOR_SCOPE MMPlugin *
+mm_plugin_create_xmmusb (void)
+{
+    static const gchar *subsystems[] = { "tty", "net", NULL };
+    /* Intel XMM7360, plain-USB CDC-ACM+CDC-NCM variant (e.g. Fibocom
+     * L860-GL). NOT the PCIe/iosm/wwan-RPC variant already handled by
+     * the stock 'intel' plugin since MM 1.26. */
+    static const mm_uint16_pair product_ids[] = {
+        { 0x8087, 0x095a },
+    };
+
+    return MM_PLUGIN (
+        g_object_new (MM_TYPE_PLUGIN_XMMUSB,
+                      MM_PLUGIN_NAME,               MM_MODULE_NAME,
+                      MM_PLUGIN_ALLOWED_SUBSYSTEMS, subsystems,
+                      MM_PLUGIN_ALLOWED_PRODUCT_IDS, product_ids,
+                      MM_PLUGIN_ALLOWED_AT,         TRUE,
+                      MM_PLUGIN_ICERA_PROBE,        FALSE,
+                      MM_PLUGIN_REMOVE_ECHO,        TRUE,
+                      NULL));
+}
+
+static void
+mm_plugin_xmmusb_init (MMPluginXmmUsb *self)
+{
+}
+
+static void
+mm_plugin_xmmusb_class_init (MMPluginXmmUsbClass *klass)
+{
+    MMPluginClass *plugin_class = MM_PLUGIN_CLASS (klass);
+    plugin_class->create_modem = create_modem;
+}
